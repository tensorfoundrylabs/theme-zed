{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "TensorFoundry Dark",
  "author": "TensorFoundry",
  "themes": [
    {
      "name": "TensorFoundry Dark",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "background": "#131720",
        "surface.background": "#191E29",
        "elevated_surface.background": "#222836",
        "border": "#303747",
        "border.variant": "#252B38",
        "border.focused": "#FF8A26",
        "border.selected": "#A86EFF",
        "border.transparent": "#00000000",
        "border.disabled": "#282E3B",

        "element.background": "#191E29",
