          "constructor": { "color": "#B6A0E0" },
          "embedded": { "color": "#DADCE3" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#B6A0E0" },
          "function": { "color": "#E7C27D" },
          "function.builtin": { "color": "#E7C27D" },
          "function.macro": { "color": "#E7C27D" },
          "function.method": { "color": "#E7C27D" },
          "hint": { "color": "#7B7F8D", "font_style": "italic" },
          "keyword": { "color": "#E59B75" },
          "label": { "color": "#7EC9D4" },
          "link_text": { "color": "#67DFF5", "font_style": "normal" },
          "link_uri": { "color": "#82AAFF" },
          "namespace": { "color": "#C8CAD2" },
          "number": { "color": "#C9A7D8" },
          "operator": { "color": "#C78569" },
          "predictive": { "color": "#707482", "font_style": "italic" },
