          "punctuation.markup": { "color": "#9699A5" },
          "punctuation.special": { "color": "#C9A7D8" },
          "selector": { "color": "#B6A0E0" },
          "selector.pseudo": { "color": "#7EC9D4" },
          "string": { "color": "#A9C77D" },
          "string.escape": { "color": "#7EC9D4" },
          "string.regex": { "color": "#8FC7B5" },
          "string.special": { "color": "#D8B58A" },
          "string.special.symbol": { "color": "#E59B75" },
          "tag": { "color": "#D98B7C" },
          "tag.doctype": { "color": "#858895" },
          "text.literal": { "color": "#D8B58A" },
          "title": { "color": "#DADCE3", "font_weight": 700 },
          "type": { "color": "#B6A0E0" },
          "type.builtin": { "color": "#B6A0E0" },
          "type.parameter": { "color": "#C9A7D8" },
          "variable": { "color": "#DADCE3" },
          "variable.builtin": { "color": "#7EC9D4", "font_style": "italic" },
          "variable.parameter": { "color": "#D3A3BA" },
          "variable.special": { "color": "#7EC9D4", "font_style": "italic" },
          "variant": { "color": "#B6A0E0" },
