{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "TensorFoundry Dark Night",
  "author": "TensorFoundry",
  "themes": [
    {
      "name": "TensorFoundry Dark Night",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "background": "#0B0B0E",
        "surface.background": "#101014",
        "elevated_surface.background": "#17171D",
        "border": "#292930",
        "border.variant": "#202027",
        "border.focused": "#FF7A00",
        "border.selected": "#A86EFF",
        "border.transparent": "#00000000",
        "border.disabled": "#202027",

        "element.background": "#101014",
        "element.hover": "#1B1B22",
        "element.active": "#23232B",
        "element.selected": "#28242F",
        "element.disabled": "#16161B",
        "drop_target.background": "#FF7A0033",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#FFFFFF0A",
        "ghost_element.active": "#FFFFFF10",
        "ghost_element.selected": "#A33CFF1F",
        "ghost_element.disabled": "#FFFFFF05",

        "text": "#E9E8ED",
        "text.muted": "#9A99A6",
        "text.placeholder": "#777682",
        "text.disabled": "#5C5B65",
        "text.accent": "#FFA45C",
        "icon": "#B4B2BD",
        "icon.muted": "#807F8B",
        "icon.placeholder": "#686772",
        "icon.disabled": "#50505A",
        "icon.accent": "#FF8A26",
        "link_text.hover": "#75E6FA",

        "status_bar.background": "#0D0D11",
        "title_bar.background": "#0B0B0E",
        "title_bar.inactive_background": "#0B0B0E",
        "toolbar.background": "#101014",
        "tab_bar.background": "#0B0B0E",
        "tab.inactive_background": "#0B0B0E",
        "tab.active_background": "#15151A",
        "panel.background": "#0E0E12",
        "panel.focused_border": "#FF7A00",
        "panel.indent_guide": "#292930",
        "panel.indent_guide_active": "#FF7A0066",
        "panel.indent_guide_hover": "#FF9A47",
        "pane.focused_border": "#FF7A00",
        "pane_group.border": "#202027",

        "scrollbar.thumb.background": "#4A495566",
        "scrollbar.thumb.hover_background": "#62616F99",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "search.match_background": "#FF7A0040",

        "editor.foreground": "#D8D7DE",
        "editor.background": "#0C0C0F",
        "editor.gutter.background": "#0C0C0F",
        "editor.subheader.background": "#121217",
        "editor.active_line.background": "#FFFFFF08",
        "editor.highlighted_line.background": "#A33CFF12",
        "editor.line_number": "#5F5E69",
        "editor.active_line_number": "#FF9A47",
        "editor.invisible": "#4A495566",
        "editor.wrap_guide": "#27272D",
        "editor.active_wrap_guide": "#3A3943",
        "editor.indent_guide": "#232329",
        "editor.indent_guide_active": "#494852",
        "editor.document_highlight.bracket_background": "#A33CFF26",
        "editor.document_highlight.read_background": "#3AD6FF1A",
        "editor.document_highlight.write_background": "#FF7A0021",

        "conflict": "#E6C384",
        "conflict.border": "#E6C384",
        "conflict.background": "#E6C3841A",
        "created": "#73DACA",
        "created.border": "#73DACA",
        "created.background": "#73DACA17",
        "deleted": "#F7768E",
        "deleted.border": "#F7768E",
        "deleted.background": "#F7768E17",
        "hidden": "#686772",
        "hidden.border": "#686772",
        "hidden.background": "#68677212",
        "hint": "#A99CFF",
        "hint.border": "#A99CFF",
        "hint.background": "#A99CFF17",
        "ignored": "#62616C",
        "ignored.border": "#62616C",
        "ignored.background": "#62616C12",
        "modified": "#67DFF5",
        "modified.border": "#67DFF5",
        "modified.background": "#67DFF517",
        "predictive": "#777682",
        "predictive.border": "#A33CFF66",
        "predictive.background": "#17171D",
        "renamed": "#82AAFF",
        "renamed.border": "#82AAFF",
        "renamed.background": "#82AAFF17",
        "info": "#67DFF5",
        "info.border": "#67DFF5",
        "info.background": "#67DFF51A",
        "warning": "#E6C384",
        "warning.border": "#E6C384",
        "warning.background": "#E6C3841A",
        "error": "#F7768E",
        "error.border": "#F7768E",
        "error.background": "#F7768E1A",
        "success": "#73DACA",
        "success.border": "#73DACA",
        "success.background": "#73DACA1A",
        "unreachable": "#777682",
        "unreachable.border": "#777682",
        "unreachable.background": "#77768212",

        "accents": [
          "#FF8A26",
          "#A86EFF",
          "#3AD6FF",
          "#73DACA",
          "#E6C384",
          "#F7768E",
          "#82AAFF"
        ],
        "players": [
          { "cursor": "#FF8A26", "selection": "#FF7A0038", "background": "#FF8A26" },
          { "cursor": "#A86EFF", "selection": "#A33CFF38", "background": "#A86EFF" },
          { "cursor": "#3AD6FF", "selection": "#3AD6FF38", "background": "#3AD6FF" },
          { "cursor": "#73DACA", "selection": "#73DACA38", "background": "#73DACA" },
          { "cursor": "#E6C384", "selection": "#E6C38438", "background": "#E6C384" },
          { "cursor": "#F7768E", "selection": "#F7768E38", "background": "#F7768E" }
        ],

        "terminal.background": "#0B0B0E",
        "terminal.ansi.background": "#0B0B0E",
        "terminal.foreground": "#D8D7DE",
        "terminal.dim_foreground": "#777682",
        "terminal.bright_foreground": "#F5F4F7",
        "terminal.ansi.black": "#16161B",
        "terminal.ansi.red": "#E6677E",
        "terminal.ansi.green": "#68C8B9",
        "terminal.ansi.yellow": "#D8B878",
        "terminal.ansi.blue": "#759BE8",
        "terminal.ansi.magenta": "#A98AE6",
        "terminal.ansi.cyan": "#55C7DA",
        "terminal.ansi.white": "#C9C8D0",
        "terminal.ansi.bright_black": "#666570",
        "terminal.ansi.bright_red": "#F7768E",
        "terminal.ansi.bright_green": "#73DACA",
        "terminal.ansi.bright_yellow": "#E6C384",
        "terminal.ansi.bright_blue": "#82AAFF",
        "terminal.ansi.bright_magenta": "#C099FF",
        "terminal.ansi.bright_cyan": "#67DFF5",
        "terminal.ansi.bright_white": "#F5F4F7",
        "terminal.ansi.dim_black": "#111116",
        "terminal.ansi.dim_red": "#9E4B5C",
        "terminal.ansi.dim_green": "#4D9187",
        "terminal.ansi.dim_yellow": "#967F55",
        "terminal.ansi.dim_blue": "#536B9E",
        "terminal.ansi.dim_magenta": "#735F9C",
        "terminal.ansi.dim_cyan": "#3D8792",
        "terminal.ansi.dim_white": "#8C8B94",

        "syntax": {
          "attribute": { "color": "#C8C7D0" },
          "boolean": { "color": "#FF9D5C" },
          "comment": { "color": "#7D7C89", "font_style": "italic" },
          "comment.doc": { "color": "#898895", "font_style": "italic" },
          "constant": { "color": "#E6C384" },
          "constructor": { "color": "#C099FF" },
          "embedded": { "color": "#D8D7DE" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#C099FF" },
          "function": { "color": "#67DFF5" },
          "hint": { "color": "#777682", "font_style": "italic" },
          "keyword": { "color": "#FF9D5C" },
          "label": { "color": "#C099FF" },
          "link_text": { "color": "#67DFF5", "font_style": "normal" },
          "link_uri": { "color": "#82AAFF" },
          "number": { "color": "#E6C384" },
          "operator": { "color": "#B4B2BD" },
          "predictive": { "color": "#666570", "font_style": "italic" },
          "preproc": { "color": "#F08BA0" },
          "primary": { "color": "#D8D7DE" },
          "property": { "color": "#CFCDD6" },
          "punctuation": { "color": "#8E8D99" },
          "punctuation.bracket": { "color": "#A7A5AF" },
          "punctuation.delimiter": { "color": "#8E8D99" },
          "punctuation.list_marker": { "color": "#FF9D5C" },
          "punctuation.special": { "color": "#FF9D5C" },
          "string": { "color": "#8BD49C" },
          "string.escape": { "color": "#67DFF5" },
          "string.regex": { "color": "#73DACA" },
          "string.special": { "color": "#73DACA" },
          "string.special.symbol": { "color": "#E6C384" },
          "tag": { "color": "#FF8E7A" },
          "text.literal": { "color": "#8BD49C" },
          "title": { "color": "#C099FF", "font_weight": 700 },
          "type": { "color": "#C099FF" },
          "variable": { "color": "#D8D7DE" },
          "variable.special": { "color": "#FF9D5C" },
          "variant": { "color": "#C099FF" }
        }
